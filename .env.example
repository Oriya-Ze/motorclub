# ── General ──────────────────────────────────────────
COMPOSE_PROJECT_NAME=motorclub
ENVIRONMENT=local
LOG_LEVEL=INFO
APP_VERSION=dev

# ── Database ─────────────────────────────────────────
# Schema is managed by Alembic (see README). Run:
#   docker compose run --rm backend alembic upgrade head
POSTGRES_USER=motorclub
POSTGRES_PASSWORD=motorclub_dev
POSTGRES_DB=motorclub
DATABASE_URL=postgresql+asyncpg://motorclub:motorclub_dev@postgres:5432/motorclub

# ── Auth ─────────────────────────────────────────────
# local = JWT auth for Docker/local testing
# cognito = AWS Cognito (future phase)
AUTH_PROVIDER=local
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── AWS Cognito (required when AUTH_PROVIDER=cognito) ─
AWS_REGION=eu-central-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# Cognito Hosted UI domain prefix — required for Google OAuth (e.g. motorclub-serverless)
COGNITO_DOMAIN=

# ── Backend ──────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
UPLOAD_DIR=/app/uploads

# ── Media storage ────────────────────────────────────
# local = multipart upload to UPLOAD_DIR (development)
# s3    = presigned PUT to S3 (requires bucket + IAM credentials)
MEDIA_STORAGE_PROVIDER=local
MEDIA_BASE_URL=
S3_MEDIA_BUCKET=
S3_PRESIGNED_URL_EXPIRY_SECONDS=300
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_VIDEO_UPLOAD_BYTES=10485760

# ── Frontend ─────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
# Required when MEDIA_STORAGE_PROVIDER=s3 (mirrors backend MEDIA_BASE_URL)
VITE_MEDIA_BASE_URL=

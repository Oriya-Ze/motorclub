# ── General ──────────────────────────────────────────
COMPOSE_PROJECT_NAME=motorclub

# ── Database ─────────────────────────────────────────
POSTGRES_USER=motorclub
POSTGRES_PASSWORD=motorclub_dev
POSTGRES_DB=motorclub
DATABASE_URL=postgresql+asyncpg://motorclub:motorclub_dev@postgres:5432/motorclub

# ── Auth ─────────────────────────────────────────────
# local = JWT auth for Docker/local testing
# cognito = AWS Cognito (production)
AUTH_PROVIDER=local
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── AWS Cognito (used when AUTH_PROVIDER=cognito) ───
AWS_REGION=eu-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# ── Backend ──────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
UPLOAD_DIR=/app/uploads

# ── Frontend ─────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1

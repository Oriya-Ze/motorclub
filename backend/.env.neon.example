# Copy to .env.neon (gitignored) and set your Neon pooled connection string.
# Use postgresql+asyncpg:// and ?ssl=require (not sslmode=require).
#
# Example:
# DATABASE_URL=postgresql+asyncpg://neondb_owner:SECRET@ep-xxx.us-east-1.aws.neon.tech/neondb?ssl=require

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?ssl=require
